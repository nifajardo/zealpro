{
  "name": "zealpro-ui-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/app.js && node --check src/model.js && node --check src/data.js && node --check server.mjs && node --check backend/database.mjs && node --check backend/workspace.mjs && node --check backend/api.mjs && node --check backend/backup.mjs && node --check backend/cli.mjs",
    "db:init": "node backend/cli.mjs init",
    "db:status": "node backend/cli.mjs status",
    "db:seed": "node backend/cli.mjs seed",
    "db:backup": "node backend/cli.mjs backup",
    "db:export:sql": "node backend/cli.mjs export-sql",
    "db:import": "node backend/cli.mjs import",
    "test:db": "node --test tests/database.test.js tests/database-export.test.js tests/api.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-tools": "0.4.14"
  }
}
